cabal-version: 3.14
name: haskllm
version: 0.1.0.0
synopsis: Haskell LLM client library
description: A Haskell library for interacting with LLM providers including OpenAI GPT-5 and vLLM/Qwen
license: MIT
author: Author
maintainer: maintainer@example.com
category: AI
build-type: Simple

library
  exposed-modules:
    HaskLLM
    HaskLLM.OpenAI.GPT5
    HaskLLM.VLLM.QweN2_5

  hs-source-dirs: src
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    http-client,
    http-client-tls,
    text

  default-language: GHC2021
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

test-suite haskllm-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    directory,
    filepath,
    haskllm,
    hspec,
    random,
    scientific,
    text,
    time

  default-language: GHC2021
  ghc-options:
    -Wall
    -threaded
    -rtsopts
    -with-rtsopts=-N
